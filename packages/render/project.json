{
  "name": "render",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/render/src",
  "prefix": "lib",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:render"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/render/ng-package.json",
        "tsConfig": "packages/render/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/render/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "dependsOn": ["copy-license", "^build"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "copy-license": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/LICENSE"],
      "outputs": ["{projectRoot}/LICENSE"],
      "cache": true,
      "options": {
        "command": "cp ../../LICENSE .",
        "cwd": "packages/render"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs dist/packages/render",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
