{
  "name": "render",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/render/src",
  "prefix": "rte",
  "projectType": "library",
  "tags": [
    "scope:render"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/render/ng-package.json",
        "tsConfig": "packages/render/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/render/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "dependsOn": [
        "copy-license",
        "^build"
      ]
    },
    "unit-test-build": {
      "executor": "@nx/angular:application",
      "options": {
        "outputPath": "dist/out-tsc/render-unit-test",
        "tsConfig": "packages/render/tsconfig.spec.json"
      },
      "configurations": {
        "zoneless": {
          "polyfills": []
        },
        "zone": {
          "polyfills": [
            "zone.js"
          ]
        }
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": "packages/render/vitest-base.config.mts",
        "buildTarget": "render:unit-test-build:zoneless",
        "providersFile": "packages/render/src/testing-support/providers.zoneless.ts"
      }
    },
    "test-zone": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": "packages/render/vitest-base.config.mts",
        "buildTarget": "render:unit-test-build:zone",
        "providersFile": "packages/render/src/testing-support/providers.zone.ts"
      }
    },
    "copy-license": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/LICENSE"
      ],
      "outputs": [
        "{projectRoot}/LICENSE"
      ],
      "cache": true,
      "options": {
        "command": "cp ../../LICENSE .",
        "cwd": "packages/render"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs dist/packages/render",
        "cwd": "{workspaceRoot}"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-size.mjs",
        "{projectRoot}/size-budget.json",
        "{projectRoot}/size-page.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-size.mjs --config packages/render/size-budget.json --report dist/reports/size/render.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/reports/size/render.json"
      ]
    },
    "api": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        "{projectRoot}/api/**/*",
        "{workspaceRoot}/tools/api-report.mjs",
        {
          "env": "UPDATE_API"
        }
      ],
      "outputs": [
        "{projectRoot}/api"
      ],
      "cache": true,
      "options": {
        "command": "node tools/api-report.mjs dist/packages/render",
        "cwd": "{workspaceRoot}"
      }
    },
    "coverage": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/packages/render"
      ],
      "cache": true,
      "options": {
        "watch": false,
        "runnerConfig": "packages/render/vitest-base.config.mts",
        "buildTarget": "render:unit-test-build:zoneless",
        "providersFile": "packages/render/src/testing-support/providers.zoneless.ts",
        "coverage": true,
        "coverageReporters": [
          "json-summary",
          "lcov",
          "html"
        ],
        "exclude": [
          "**/fuzz.spec.ts"
        ]
      }
    },
    "test-timed": {
      "executor": "@nx/angular:unit-test",
      "cache": true,
      "parallelism": false,
      "options": {
        "watch": false,
        "runnerConfig": "packages/render/vitest-base.config.mts",
        "buildTarget": "render:unit-test-build:zoneless",
        "providersFile": "packages/render/src/testing-support/providers.zoneless.ts",
        "include": [
          "**/fuzz.spec.ts"
        ]
      }
    }
  }
}
