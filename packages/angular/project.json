{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/src",
  "prefix": "rte",
  "projectType": "library",
  "tags": ["scope:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/ng-package.json",
        "tsConfig": "packages/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "dependsOn": ["copy-license", "^build"]
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "copy-license": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/LICENSE"],
      "outputs": ["{projectRoot}/LICENSE"],
      "cache": true,
      "options": {
        "command": "cp ../../LICENSE .",
        "cwd": "packages/angular"
      }
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs dist/packages/angular",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
