{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/angular/src",
  "prefix": "rte",
  "projectType": "library",
  "tags": ["scope:angular"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/angular/ng-package.json",
        "tsConfig": "packages/angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "dependsOn": ["copy-license", "^build"]
    },
    "unit-test-build": {
      "executor": "@nx/angular:application",
      "options": {
        "outputPath": "dist/out-tsc/angular-unit-test",
        "tsConfig": "packages/angular/tsconfig.spec.json"
      },
      "configurations": {
        "zoneless": {
          "polyfills": []
        },
        "zone": {
          "polyfills": ["zone.js"]
        }
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": "packages/angular/vitest-base.config.mts",
        "buildTarget": "angular:unit-test-build:zoneless",
        "providersFile": "packages/angular/src/testing-support/providers.zoneless.ts"
      }
    },
    "test-zone": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": "packages/angular/vitest-base.config.mts",
        "buildTarget": "angular:unit-test-build:zone",
        "providersFile": "packages/angular/src/testing-support/providers.zone.ts"
      }
    },
    "copy-license": {
      "executor": "nx:run-commands",
      "inputs": ["{workspaceRoot}/LICENSE"],
      "outputs": ["{projectRoot}/LICENSE"],
      "cache": true,
      "options": {
        "command": "cp ../../LICENSE .",
        "cwd": "packages/angular"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-size.mjs",
        "{projectRoot}/size-budget.json"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-size.mjs --config packages/angular/size-budget.json --report dist/reports/size/angular.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/reports/size/angular.json"]
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "api"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs dist/packages/angular",
        "cwd": "{workspaceRoot}"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        "{projectRoot}/api/**/*",
        "{workspaceRoot}/tools/api-report.mjs",
        "{workspaceRoot}/tools/css-api.mjs",
        "{projectRoot}/styles/*.css",
        "{projectRoot}/src/*.css",
        "{projectRoot}/README.md",
        "{workspaceRoot}/apps/docs/content/guia/*.md",
        {
          "env": "UPDATE_API"
        }
      ],
      "outputs": ["{projectRoot}/api"],
      "cache": true,
      "options": {
        "command": "node tools/api-report.mjs dist/packages/angular && node tools/css-api.mjs packages/angular",
        "cwd": "{workspaceRoot}"
      }
    },
    "coverage": {
      "executor": "@nx/angular:unit-test",
      "outputs": ["{workspaceRoot}/coverage/packages/angular"],
      "cache": true,
      "options": {
        "watch": false,
        "runnerConfig": "packages/angular/vitest-base.config.mts",
        "buildTarget": "angular:unit-test-build:zoneless",
        "providersFile": "packages/angular/src/testing-support/providers.zoneless.ts",
        "coverage": true,
        "coverageReporters": ["json-summary", "lcov", "html"]
      }
    }
  }
}
