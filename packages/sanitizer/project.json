{
  "name": "sanitizer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/sanitizer/src",
  "projectType": "library",
  "tags": ["scope:sanitizer"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/LICENSE"],
      "options": {
        "command": "tsup && cp ../../LICENSE .",
        "cwd": "packages/sanitizer"
      },
      "cache": true,
      "dependsOn": ["^build"]
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs packages/sanitizer",
        "cwd": "{workspaceRoot}"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-size.mjs",
        "{projectRoot}/size-budget.json"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-size.mjs --config packages/sanitizer/size-budget.json --report dist/reports/size/sanitizer.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/reports/size/sanitizer.json"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "cache": true,
      "options": {
        "command": "tsc -p packages/sanitizer/tsconfig.spec.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        "{projectRoot}/api/**/*",
        "{workspaceRoot}/tools/api-report.mjs",
        {
          "env": "UPDATE_API"
        }
      ],
      "outputs": ["{projectRoot}/api"],
      "cache": true,
      "options": {
        "command": "node tools/api-report.mjs packages/sanitizer",
        "cwd": "{workspaceRoot}"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/packages/sanitizer"],
      "cache": true,
      "options": {
        "command": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reporter=html --exclude \"**/node_modules/**\" --exclude src/limits.spec.ts --exclude src/perf.spec.ts --exclude src/timed.spec.ts --coverage.thresholds.lines=0 --coverage.thresholds.branches=0",
        "cwd": "packages/sanitizer"
      }
    }
  }
}
