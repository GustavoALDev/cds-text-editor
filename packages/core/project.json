{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "tags": ["scope:core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/LICENSE"],
      "options": {
        "command": "tsup && cp ../../LICENSE .",
        "cwd": "packages/core"
      },
      "cache": true,
      "dependsOn": ["^build"]
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs packages/core",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "cache": true,
      "options": {
        "command": "tsc -p packages/core/tsconfig.spec.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/docs/html-schema.md",
        "{workspaceRoot}/fixtures/content/**/*"
      ]
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-size.mjs",
        "{projectRoot}/size-budget.json"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-size.mjs --config packages/core/size-budget.json --report dist/reports/size/core.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/reports/size/core.json"]
    },
    "api": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        "{projectRoot}/api/**/*",
        "{workspaceRoot}/tools/api-report.mjs",
        {
          "env": "UPDATE_API"
        }
      ],
      "outputs": ["{projectRoot}/api"],
      "cache": true,
      "options": {
        "command": "node tools/api-report.mjs packages/core",
        "cwd": "{workspaceRoot}"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/docs/html-schema.md",
        "{workspaceRoot}/fixtures/content/**/*"
      ],
      "outputs": ["{workspaceRoot}/coverage/packages/core"],
      "cache": true,
      "options": {
        "command": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reporter=html",
        "cwd": "packages/core"
      }
    }
  }
}
