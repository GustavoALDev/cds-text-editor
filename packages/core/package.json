{
  "name": "@cds/rte-core",
  "version": "0.1.0",
  "description": "Núcleo do editor de texto rico cds-text-editor: extensões Tiptap, utilitários e esquema do HTML.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./embeds": {
      "types": "./dist/embeds/index.d.ts",
      "default": "./dist/embeds/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "default": "./dist/html/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "default": "./dist/extensions/index.js"
    },
    "./code-languages": {
      "types": "./dist/code-languages/index.d.ts",
      "default": "./dist/code-languages/index.js"
    },
    "./styles/content.css": "./styles/content.css"
  },
  "peerDependencies": {
