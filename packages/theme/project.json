{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["scope:theme"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "tsup && cp src/theme.css dist/theme.css",
        "cwd": "packages/theme"
      },
      "cache": true,
      "dependsOn": ["^build"]
    }
  }
}
