{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["scope:theme"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/LICENSE"],
      "options": {
        "command": "tsup && cp src/theme.css dist/theme.css && cp ../../LICENSE .",
        "cwd": "packages/theme"
      },
      "cache": true,
      "dependsOn": ["^build"]
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs packages/theme",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "cache": true,
      "options": {
        "command": "tsc -p packages/theme/tsconfig.spec.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
