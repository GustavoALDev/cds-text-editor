{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["scope:theme"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist", "{projectRoot}/LICENSE"],
      "options": {
        "command": "tsup && cp src/theme.css dist/theme.css && cp ../../LICENSE .",
        "cwd": "packages/theme"
      },
      "cache": true,
      "dependsOn": ["^build"]
    },
    "verify-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "api"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-pack.mjs"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-pack.mjs packages/theme",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "cache": true,
      "options": {
        "command": "tsc -p packages/theme/tsconfig.spec.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "size": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/check-size.mjs",
        "{projectRoot}/size-budget.json"
      ],
      "cache": true,
      "options": {
        "command": "node tools/check-size.mjs packages/theme/dist/index.js --report dist/reports/size/theme.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/dist/reports/size/theme.json"]
    },
    "api": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "inputs": [
        "production",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*.d.ts",
          "transitive": true
        },
        "{projectRoot}/api/**/*",
        "{workspaceRoot}/tools/api-report.mjs",
        "{workspaceRoot}/tools/css-api.mjs",
        "{projectRoot}/styles/*.css",
        "{projectRoot}/src/*.css",
        "{projectRoot}/README.md",
        "{workspaceRoot}/apps/docs/content/guia/*.md",
        {
          "env": "UPDATE_API"
        }
      ],
      "outputs": ["{projectRoot}/api"],
      "cache": true,
      "options": {
        "command": "node tools/api-report.mjs packages/theme && node tools/css-api.mjs packages/theme",
        "cwd": "{workspaceRoot}"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/packages/theme"],
      "cache": true,
      "options": {
        "command": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reporter=html",
        "cwd": "packages/theme"
      }
    }
  }
}
