{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "dom"],
    "importHelpers": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "paths": {
      "@comodeviaser/rte-core": ["./packages/core/src/index.ts"],
      "@comodeviaser/rte-core/embeds": ["./packages/core/embeds/src/index.ts"],
      "@comodeviaser/rte-core/html": ["./packages/core/html/src/index.ts"],
      "@comodeviaser/rte-core/extensions": ["./packages/core/extensions/src/index.ts"],
      "@comodeviaser/rte-core/code-languages": [
        "./packages/core/code-languages/src/index.ts"
      ],
      "@comodeviaser/rte-sanitizer": ["./packages/sanitizer/src/index.ts"],
      "@comodeviaser/rte-theme": ["./packages/theme/src/index.ts"],
      "@comodeviaser/rte-angular": ["./packages/angular/src/index.ts"],
      "@comodeviaser/rte-angular/i18n": ["./packages/angular/i18n/src/index.ts"],
      "@comodeviaser/rte-angular/testing": ["./packages/angular/testing/src/index.ts"],
      "@comodeviaser/rte-angular/upload": ["./packages/angular/upload/src/index.ts"],
      "@comodeviaser/rte-angular/validators": [
        "./packages/angular/validators/src/index.ts"
      ],
      "@comodeviaser/rte-render": ["./packages/render/src/index.ts"],
      "@comodeviaser/rte-render/i18n": ["./packages/render/i18n/src/index.ts"],
      "@comodeviaser/rte-render/toc": ["./packages/render/toc/src/index.ts"]
    }
  }
}
