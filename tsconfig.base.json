{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "dom"],
    "importHelpers": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "paths": {
      "@cds/rte-core": ["packages/core/src/index.ts"],
      "@cds/rte-core/embeds": ["packages/core/embeds/src/index.ts"],
      "@cds/rte-core/code-languages": [
        "packages/core/code-languages/src/index.ts"
      ],
      "@cds/rte-sanitizer": ["packages/sanitizer/src/index.ts"],
      "@cds/rte-theme": ["packages/theme/src/index.ts"]
    }
  }
}
